diff --git a/sim/tests/test_merchant_room_stock.py b/sim/tests/test_merchant_room_stock.py
new file mode 100644
index 00000000..34c8569c
--- /dev/null
+++ b/sim/tests/test_merchant_room_stock.py
@@ -0,0 +1,112 @@
+"""merchant_room_stock: the stock a merchant counts against its room in a market. Under the search rules it is what the merchant holds
+there; under the clearing rules no less than the cargo that stands there when it buys the same every year, so a year's cargo is at most
+half its share. The plain rules, then `merchants.orders` given them."""
+
+QUICK_TOPIC = True
+
+import unittest
+
+import numpy as np
+
+from sim.economy import merchants, rule_sets
+from sim.economy.merchant_room_stock import all_it_holds, no_less_than_the_cargo_standing_at_rest
+from sim.tests.test_economy_merchants import SPECS, View, merchant, world
+
+NAN = np.nan
+SHARE = 0.3
+
+
+class AllItHolds(unittest.TestCase):
+    def test_what_is_held_counts_and_nothing_more(self):
+        held = np.array([30.0, 0.0, 12.0])
+        counted = all_it_holds(held, np.array([0.0, 0.0, 12.0]), np.array([100.0, 100.0, NAN]), SHARE)
+        self.assertEqual(counted.tolist(), [30.0, 0.0, 12.0])
+
+
+class NoLessThanTheCargoStandingAtRest(unittest.TestCase):
+    def counted(self, held, volume, on_the_road=0.0):
+        return float(no_less_than_the_cargo_standing_at_rest(np.array([held]), np.array([on_the_road]), np.array([volume]), SHARE)[0])
+
+    def test_a_merchant_holding_nothing_counts_half_its_share_of_the_years_volume(self):
+        self.assertAlmostEqual(self.counted(0.0, 100.0), 15.0)
+
+    def test_stock_under_half_the_share_counts_as_half_the_share(self):
+        self.assertAlmostEqual(self.counted(9.0, 100.0), 15.0)
+
+    def test_stock_over_half_the_share_counts_whole(self):
+        self.assertEqual(self.counted(22.0, 100.0), 22.0)
+        self.assertEqual(self.counted(40.0, 100.0), 40.0)
+
+    def test_what_is_on_the_road_is_part_of_what_is_held(self):
+        self.assertEqual(self.counted(22.0, 100.0, on_the_road=22.0), 22.0)
+
+    def test_a_market_whose_volume_was_never_seen_counts_what_is_held(self):
+        self.assertEqual(self.counted(7.0, NAN), 7.0)
+        self.assertEqual(self.counted(0.0, NAN), 0.0)
+
+    def bought_over_years(self, held, years, rule):
+        bought = []
+        for _year in range(years):
+            room = max(0.0, SHARE * 100.0 - float(rule(np.array([held]), np.array([0.0]), np.array([100.0]), SHARE)[0]))
+            bought.append(room)
+            held = room                 # last year's cargo sold, this year's stands in the market
+        return bought
+
+    def test_from_an_empty_market_the_merchant_buys_the_same_every_year(self):
+        self.assertEqual(self.bought_over_years(0.0, 4, no_less_than_the_cargo_standing_at_rest), [15.0, 15.0, 15.0, 15.0])
+
+    def test_from_a_full_share_it_comes_to_the_same_cargo_within_two_years(self):
+        self.assertEqual(self.bought_over_years(30.0, 4, no_less_than_the_cargo_standing_at_rest), [0.0, 15.0, 15.0, 15.0])
+
+    def test_counting_only_what_is_held_it_buys_every_other_year_for_ever(self):
+        self.assertEqual(self.bought_over_years(0.0, 4, all_it_holds), [30.0, 0.0, 30.0, 0.0])
+
+    def test_never_more_than_the_share_stands_in_the_market_with_the_new_cargo(self):
+        for held in (0.0, 10.0, 15.0, 22.0, 30.0, 45.0):
+            room = max(0.0, SHARE * 100.0 - self.counted(held, 100.0))
+            self.assertLessEqual(held + room, max(held, SHARE * 100.0))
+
+
+def ordered(held, rule=None, cash=1000.0):
+    """The orders of a merchant on the two-tile world: salt is cheap on `a` and dear on `b`, where the market trades 100 units a year."""
+    carriage, area_map, area_a, area_b = world()
+    who = merchant()
+    who.expected_prices = {("salt", area_a["salt"]): 2.0, ("salt", area_b["salt"]): 5.0}
+    who.expected_volumes = {("salt", area_b["salt"]): 100.0}
+    rules = {} if rule is None else dict(stock_counted_against_room=rule)
+    return merchants.orders(who, View({}), carriage, area_map, cash, held, SPECS, 0.0, **rules)
+
+
+def bid_for(orders):
+    return sum(bid.floor_quantity + bid.flexible_quantity for bid in orders.bids)
+
+
+class OrdersWithCargoStandingAtTheDestination(unittest.TestCase):
+    SHARE_OF_THE_MARKET = merchants.MERCHANT_MARKET_SHARE * 100.0
+
+    def test_as_before_a_merchant_holding_nothing_bids_for_its_whole_share(self):
+        self.assertAlmostEqual(bid_for(ordered({})), self.SHARE_OF_THE_MARKET)
+        self.assertAlmostEqual(bid_for(ordered({}, rule=all_it_holds)), self.SHARE_OF_THE_MARKET)
+
+    def test_holding_nothing_it_bids_for_half_its_share(self):
+        self.assertAlmostEqual(bid_for(ordered({}, rule=no_less_than_the_cargo_standing_at_rest)), self.SHARE_OF_THE_MARKET / 2.0)
+
+    def test_holding_half_its_share_at_the_destination_it_bids_for_the_other_half_under_either_rule(self):
+        held = {("salt", "b"): self.SHARE_OF_THE_MARKET / 2.0}
+        self.assertAlmostEqual(bid_for(ordered(held)), self.SHARE_OF_THE_MARKET / 2.0)
+        self.assertAlmostEqual(bid_for(ordered(held, rule=no_less_than_the_cargo_standing_at_rest)), self.SHARE_OF_THE_MARKET / 2.0)
+
+    def test_holding_its_whole_share_at_the_destination_it_bids_for_nothing_under_either_rule(self):
+        held = {("salt", "b"): self.SHARE_OF_THE_MARKET}
+        self.assertEqual(bid_for(ordered(held)), 0.0)
+        self.assertEqual(bid_for(ordered(held, rule=no_less_than_the_cargo_standing_at_rest)), 0.0)
+
+
+class Rules(unittest.TestCase):
+    def test_which_rule_each_set_runs(self):
