@@ -0,0 +1,27 @@
+"""The stock a merchant counts against its room in a market (the rule sets' `merchant_stock_counted_against_room`).
+
+A merchant bids for no more cargo into a market than its share of what the market trades in a year, less what it
+already has for it (`merchants_shares.room_left`), and goods bought one year are sold the next. Under the search rules
+what it holds in the market is all that counts: a merchant that filled its share one year finds no room the next, buys
+nothing, and finds the whole share free the year after, so it buys every other year and a part of each market it serves
+comes and goes with it. That rule rests at half the share bought every year (the cargo standing in the market while
+the next is bought), and any swing around it lasts for ever. Under the clearing rules a year's cargo is no more than
+that half: at least half the share counts as taken, so the merchant comes to buying the same every year, and it still
+never has more than its share standing in a market. Plain functions over arrays by market slot."""
+import numpy as np
+
+YEARS_A_CARGO_TURNS_IN = 2.0     # the timing of `merchants`: bought in one year's market, sold in the next year's
+
+
+def all_it_holds(held, _on_the_road, _volumes, _own_share):
+    """Units counted against the room in each market: all the merchant holds there, with what is on the road to it
+    (`held` counts both)."""
+    return held
+
+
+def no_less_than_the_cargo_standing_at_rest(held, _on_the_road, volumes, own_share):
+    """Units counted against the room in each market: what the merchant holds there (with what is on the road), and
+    no less than the cargo that stands there when it buys the same every year, its share of the market's yearly volume
+    over the years a cargo turns in. What it holds alone where the market's volume was never seen (NaN)."""
+    standing_at_rest = np.where(np.isnan(volumes), 0.0, own_share * volumes / YEARS_A_CARGO_TURNS_IN)
+    return np.maximum(held, standing_at_rest)
