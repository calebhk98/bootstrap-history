diff --git a/sim/tests/test_expected_sales_sell_out.py b/sim/tests/test_expected_sales_sell_out.py
new file mode 100644
index 00000000..073eb019
--- /dev/null
+++ b/sim/tests/test_expected_sales_sell_out.py
@@ -0,0 +1,69 @@
+"""A sell-out shows a seller's buyers would have taken at least what it had, so it never lowers the sales the seller expects;
+stock left unsold does. Each test calls one function on written-out inputs."""
+QUICK_TOPIC = True
+
+import unittest
+
+from sim.economy import expected_sales, producers, year_close
+from sim.economy.types import Recipe
+from sim.economy.year_ledger import YearLedger
+
+# a run sows 100 of grain and yields 900 of grain and 500 of straw
+FARM = Recipe("farm", {"grain": 900.0, "straw": 500.0}, {"grain": 100.0}, {"hand": 200.0})
+PRICES = {"grain": 1.0, "straw": 0.1}
+CAPACITY = 20.0
+SEED_KEPT = 100.0 * CAPACITY
+
+
+class Book:
+    def __init__(self, stocks):
+        self.stocks = stocks
+
+    def stock(self, agent, good, tile):
+        return self.stocks.get(good, 0.0)
+
+
+class HeldByASellOutTests(unittest.TestCase):
+    def test_a_seller_that_sold_out_below_what_it_expected_keeps_its_expectation(self):
+        self.assertEqual(expected_sales.held_by_a_sell_out(8.0, 10.0, sold=800.0, left=0.0), 10.0)
+
+    def test_a_seller_that_sold_out_above_what_it_expected_takes_what_it_sold(self):
+        self.assertEqual(expected_sales.held_by_a_sell_out(12.0, 10.0, sold=1200.0, left=0.0), 12.0)
+
+    def test_stock_left_unsold_lowers_the_demand_to_what_it_sold(self):
+        self.assertEqual(expected_sales.held_by_a_sell_out(8.0, 10.0, sold=800.0, left=50.0), 8.0)
+
+    def test_a_year_with_nothing_to_sell_says_nothing_about_the_buyers(self):
+        self.assertEqual(expected_sales.held_by_a_sell_out(0.0, 10.0, sold=0.0, left=0.0), 10.0)
+
+    def test_a_hair_left_in_settlement_counts_as_sold_out(self):
+        self.assertEqual(expected_sales.held_by_a_sell_out(8.0, 10.0, sold=800.0, left=800.0 * expected_sales.SOLD_OUT_LEFT_SHARE), 10.0)
+
+
+class DemandRunsTests(unittest.TestCase):
+    def farm(self):
+        return producers.Producer("farm1", "owner", "farm", "tile", capacity_runs=CAPACITY, expected_sales=10.0)
+
+    def ledger(self, grain_runs, straw_runs):
+        ledger = YearLedger()
+        ledger.sold[("farm1", "grain")] = grain_runs * 900.0
+        ledger.sold[("farm1", "straw")] = straw_runs * 500.0
+        return ledger
+
+    def demand(self, ledger, stocks):
+        return year_close.demand_runs(self.farm(), FARM, ledger, Book(stocks), lambda good, tile: "area", PRICES)
+
+    def test_a_farm_whose_grain_sold_out_keeps_its_expectation_whatever_straw_piles_up(self):
+        # all the grain beyond next year's seed sold (eight runs of it), a fifth of the straw
+        self.assertAlmostEqual(self.demand(self.ledger(8.0, 1.6), {"grain": SEED_KEPT, "straw": 3200.0}), 10.0)
+
+    def test_a_farm_left_with_grain_beyond_its_seed_takes_the_runs_it_sold(self):
+        sold_runs = (8.0 * 900.0 * 1.0 + 8.0 * 500.0 * 0.1) / (900.0 * 1.0 + 500.0 * 0.1)
+        self.assertAlmostEqual(self.demand(self.ledger(8.0, 8.0), {"grain": SEED_KEPT + 900.0, "straw": 0.0}), sold_runs)
+
+    def test_a_farm_that_sold_more_runs_than_it_expected_takes_them(self):
+        self.assertAlmostEqual(self.demand(self.ledger(14.0, 14.0), {"grain": SEED_KEPT, "straw": 0.0}), 14.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
