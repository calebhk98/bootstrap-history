+YEARS_A_TURN_OF_TRADE_TAKES = 2.0      # the timing of `merchants`: cargo bought in one year's market is sold in the next year's, and the
+                                       # coin it brings is at hand for the market after that
+
+
+def all_cash(cash: float, _carriage_set_aside: float, _value_of_stock_held: float = 0.0) -> float:
     """The coin that buys new cargo: all the merchant has."""
