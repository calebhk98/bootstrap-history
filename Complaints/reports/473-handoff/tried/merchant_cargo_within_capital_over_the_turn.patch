-def cash_less_carriage(cash: float, carriage_set_aside_for_kept_stock: float) -> float:
+def cash_less_carriage(cash: float, carriage_set_aside_for_kept_stock: float, _value_of_stock_held: float = 0.0) -> float:
     """The coin that buys new cargo: what the merchant has less what carrying the stock it keeps will cost, never below nothing."""
     return max(0.0, cash - max(0.0, carriage_set_aside_for_kept_stock))
+
+
+def spread_over_the_turn(cash: float, carriage_set_aside_for_kept_stock: float, value_of_stock_held: float = 0.0) -> float:
+    """The coin that buys new cargo: `cash_less_carriage`, and no more than the merchant's trading capital (its coin and
+    the cargo it holds, at what it expects to sell it for) over the years a turn of trade takes. A coin laid out this
+    year is back only for the market after next, so a merchant that lays out all it has each year trades two pools of
+    coin that never meet, one in the odd years and one in the even; whatever their sizes it then buys much one year and
+    little the next for ever. Held to its capital over the turn it lays out the same every year."""
+    capital = max(0.0, cash) + max(0.0, value_of_stock_held)
+    return min(cash_less_carriage(cash, carriage_set_aside_for_kept_stock), capital / YEARS_A_TURN_OF_TRADE_TAKES)
