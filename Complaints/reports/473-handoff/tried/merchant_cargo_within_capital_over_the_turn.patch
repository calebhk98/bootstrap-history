+def _value_of_stock(merchant, route, area_map, held_stock, stock) -> float:
+    """What the merchant expects to sell its stock for: each stock at hand at its own expected price of the market it stands in, each
+    haul on the road at its expected price where it is bound; a stock it has no expected price for is left out."""
+    values = []
+    for (good, tile), quantity in sorted(held_stock.items()):
+        expected = stock.expectation_of(good, tile)
+        if expected is not None and expected is not merchants.NOT_AT_HAND and quantity > 0.0:
+            values.append(quantity * expected)
+    for each in merchant.in_transit:
+        slot = route.slot_of_stock(area_map, each.good, each.destination_tile)
+        if slot is not None and not math.isnan(stock.expected[slot]):
+            values.append(each.quantity * float(stock.expected[slot]))
+    return math.fsum(values)
+
