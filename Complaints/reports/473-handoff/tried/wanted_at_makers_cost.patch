+++ b/sim/tests/test_wanted_at_cost.py
@@ -0,0 +1,83 @@
+"""A market that clears turns no buyer away, so what its buyers wanted is read at the price that covers its makers' cost: where
+it cleared above that price, the units they would have taken there. Each test calls one function on written-out inputs."""
+QUICK_TOPIC = True
+
+import math
+import unittest
+
+import numpy
+
+from sim.economy import goods_wanted_kernel, wanted_at_cost
+
+
+class CostPriceTests(unittest.TestCase):
+    def test_the_makers_costs_weigh_by_the_units_each_offers(self):
+        # thirty units that cost 2 each and ten that cost 6
+        self.assertAlmostEqual(wanted_at_cost.cost_price([(30.0, 2.0), (10.0, 6.0)]), 3.0)
+
+    def test_an_offer_whose_cost_cannot_be_priced_is_left_out(self):
+        self.assertAlmostEqual(wanted_at_cost.cost_price([(30.0, 2.0), (10.0, math.inf), (5.0, None), (4.0, 0.0)]), 2.0)
+
+    def test_no_maker_with_a_cost_gives_none(self):
+        self.assertIsNone(wanted_at_cost.cost_price([(10.0, None), (0.0, 3.0)]))
+
+
+class WantedAtCostTests(unittest.TestCase):
+    @staticmethod
+    def buyers(price):      # buyers who spend 120 whatever the price
+        return 120.0 / price
+
+    def test_a_market_cleared_above_cost_wants_what_its_buyers_take_at_cost(self):
+        self.assertAlmostEqual(wanted_at_cost.wanted_at_cost(self.buyers, 3.0, 2.0), 60.0)
+
+    def test_a_market_cleared_at_or_under_cost_wants_no_more_than_it_traded(self):
+        self.assertEqual(wanted_at_cost.wanted_at_cost(self.buyers, 2.0, 2.0), 0.0)
+        self.assertEqual(wanted_at_cost.wanted_at_cost(self.buyers, 1.5, 2.0), 0.0)
+
+    def test_a_market_with_no_makers_cost_or_no_trade_wants_nothing_more(self):
+        self.assertEqual(wanted_at_cost.wanted_at_cost(self.buyers, 3.0, None), 0.0)
+        self.assertEqual(wanted_at_cost.wanted_at_cost(self.buyers, None, 2.0), 0.0)
+
+
+class KernelTests(unittest.TestCase):
+    # market 0: makers offer 30 units costing 2 and 10 costing 6 (cost price 3), a merchant 20; it cleared at 5.
+    # Its buyers: one needs 10 whatever the price, one takes 20 at the reference price 3. Market 1 cleared at 2, under its maker's cost 4.
+    OFFER_PTR = numpy.array([0, 3, 4])
+    QUANTITY = numpy.array([30.0, 10.0, 20.0, 15.0])
+    IS_PRODUCER = numpy.array([True, True, False, True])
+    UNIT_COST = numpy.array([2.0, 6.0, numpy.nan, 4.0])
+    TRADED = numpy.array([True, True])
+    MEAN = numpy.array([5.0, 2.0])
+    BID_PTR = numpy.array([0, 2, 3])
+    FLOORS = numpy.array([10.0, 0.0, 5.0])
+    FLEXIBLES = numpy.array([0.0, 20.0, 0.0])
+    BUDGETS = numpy.array([100.0, 90.0, 50.0])
+    REFERENCES = numpy.array([3.0, 3.0, 2.0])
+    EXPONENTS = numpy.array([-1.0, -1.0, -1.0])
+    MAXIMUMS = numpy.array([numpy.inf, numpy.inf, numpy.inf])
+    CAPPED = numpy.array([False, False])
+
+    def at_cost(self, traded=None, minimum=(0.0, 0.0), has_minimum=(False, False)):
+        return goods_wanted_kernel.wanted_at_cost(
+            self.OFFER_PTR, self.QUANTITY, self.IS_PRODUCER, self.UNIT_COST, self.TRADED if traded is None else traded, self.MEAN,
+            numpy.array(minimum), numpy.array(has_minimum), self.BID_PTR, self.FLOORS, self.FLEXIBLES, self.BUDGETS, self.REFERENCES,
+            self.EXPONENTS, self.MAXIMUMS, self.CAPPED)
+
+    def test_each_market_cleared_above_its_makers_cost_wants_what_its_buyers_take_there(self):
+        numpy.testing.assert_allclose(self.at_cost(), [30.0, 0.0])
+
+    def test_a_market_that_did_not_trade_wants_nothing_more(self):
+        numpy.testing.assert_allclose(self.at_cost(traded=numpy.array([False, True])), [0.0, 0.0])
+
+    def test_the_markets_least_price_holds_the_cost_price_up(self):
+        # at the least price 4 the second buyer takes 20 * 3 / 4
+        numpy.testing.assert_allclose(self.at_cost(minimum=(4.0, 0.0), has_minimum=(True, False)), [25.0, 0.0])
+
+    def test_wanted_is_lifted_only_where_the_batch_traded(self):
+        wanted = numpy.array([12.0, 7.0, 40.0])
+        goods_wanted_kernel.lift_wanted(wanted, numpy.array([0, -1, 1]), numpy.array([30.0, 0.0]))
+        numpy.testing.assert_allclose(wanted, [30.0, 7.0, 40.0])
+
+
+if __name__ == "__main__":
+    unittest.main()
