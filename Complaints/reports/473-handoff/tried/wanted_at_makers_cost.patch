diff --git a/sim/economy/goods_wanted_kernel.py b/sim/economy/goods_wanted_kernel.py
new file mode 100644
index 00000000..b1a5aa27
--- /dev/null
+++ b/sim/economy/goods_wanted_kernel.py
@@ -0,0 +1,52 @@
+"""`wanted_at_cost` on a good's batched markets: per market, the units its buyers would take at the price that covers its
+makers' cost, where it traded above that price."""
+import numpy
+from numba import njit
+
+from . import goods_market_kernels as kernels
+from .goods_market_kernels import KERNEL
+
+
+@njit(**KERNEL)
+def cost_price(quantity, is_producer, unit_cost):
+    """wanted_at_cost.cost_price over one market's offers; NaN is None."""
+    units = 0.0
+    value = 0.0
+    for offer in range(len(quantity)):
+        cost = unit_cost[offer]
+        if is_producer[offer] and quantity[offer] > 0.0 and numpy.isfinite(cost) and cost > 0.0:
+            units += quantity[offer]
+            value += quantity[offer] * cost
+    return value / units if units > 0.0 else numpy.nan
+
+
+@njit(**KERNEL)
+def wanted_at_cost(offer_ptr, quantity, is_producer, unit_cost, traded_flag, mean, minimum, has_minimum, bid_ptr, floors, flexibles,
+                   budgets, references, exponents, maximums, capped):
+    """Per market of the batch (`offer_ptr` and `bid_ptr` cut its offers and bids), `wanted_at_cost.wanted_at_cost`: `mean` is the
+    price it traded at, `minimum` the least price its buyers are read at (`has_minimum`)."""
+    markets = len(offer_ptr) - 1
+    wanted = numpy.zeros(markets)
+    for market in range(markets):
+        if not traded_flag[market]:
+            continue
+        o0, o1 = offer_ptr[market], offer_ptr[market + 1]
+        cost = cost_price(quantity[o0:o1], is_producer[o0:o1], unit_cost[o0:o1])
+        if numpy.isnan(cost) or not mean[market] > cost:
+            continue
+        if has_minimum[market] and cost < minimum[market]:
+            cost = minimum[market]
+        b0, b1 = bid_ptr[market], bid_ptr[market + 1]
+        wanted[market] = kernels.total_wanted(cost, floors[b0:b1], flexibles[b0:b1], budgets[b0:b1], references[b0:b1],
+                                              exponents[b0:b1], maximums[b0:b1], capped[market])
+    return wanted
+
+
+@njit(**KERNEL)
+def lift_wanted(wanted, slots, at_cost):
+    """`wanted` (per market of the good) raised in place to the batch's `at_cost` (per batched market, `slots` its place in the
+    batch, -1 for a market not in it)."""
+    for place in range(len(wanted)):
+        slot = slots[place]
+        if slot >= 0 and at_cost[slot] > wanted[place]:
+            wanted[place] = at_cost[slot]
diff --git a/sim/economy/wanted_at_cost.py b/sim/economy/wanted_at_cost.py
new file mode 100644
index 00000000..1d72f0e1
--- /dev/null
+++ b/sim/economy/wanted_at_cost.py
@@ -0,0 +1,28 @@
+"""What a market's buyers wanted, read at the price that covers its makers' cost.
+
+A sold-out seller raises its ask to where its buyers' money just takes the stock (`demand_search.py`), so at the price a
+market clears at nobody is turned away and the units wanted beyond the units delivered are none. A maker reads the sales it
+can expect from what the buyers would take at a price that pays it: where a market cleared above its makers' cost, the units
+its buyers' schedules take at that cost. Above what was delivered, that is the output the market would still buy without
+loss to its makers (`expected_sales.demand_seen` shares it among them). `goods_wanted_kernel` is the same rule on a
+batch's arrays."""
+import math
+from typing import Callable, Optional, Sequence, Tuple
+
+
+def cost_price(offers: Sequence[Tuple[float, Optional[float]]]) -> Optional[float]:
+    """The price that covers the cost of a market's makers: their unit costs weighed by the units each offers. `offers`
+    are (units, unit cost) of each maker's offer; one whose cost cannot be priced is left out. None when none is left."""
+    priced = [(units, cost) for units, cost in offers if units > 0.0 and cost is not None and math.isfinite(cost) and cost > 0.0]
+    units = math.fsum(quantity for quantity, _cost in priced)
+    if not units > 0.0:
+        return None
+    return math.fsum(quantity * cost for quantity, cost in priced) / units
+
+
+def wanted_at_cost(wanted_at: Callable[[float], float], traded_price: Optional[float], cost: Optional[float]) -> float:
+    """The units the buyers take at the makers' cost price (`wanted_at(price)` is their schedule) where the market traded
+    above it; nothing where it did not trade, has no cost price, or traded at or under it."""
+    if traded_price is None or cost is None or not traded_price > cost:
+        return 0.0
+    return wanted_at(cost)
