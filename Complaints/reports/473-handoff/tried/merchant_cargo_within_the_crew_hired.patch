 hired on its tile, so a stock the hired hours cover whole is still cut, a part of every stock is offered where it stands
 whenever a crew is a hair short of the plan, and the merchant buys none of a good where it offers it: it buys every
 other year. Under the clearing rules the hours hired are set against the hours the stocks held need, crew key by crew
-key, as the dispatch cuts its shipments (`merchants.dispatch`). Plain functions of built inputs."""
+key, as the dispatch cuts its shipments (`merchants.dispatch`).
+
+New cargo: a merchant's crew is hired before the goods markets, on what last year's shipments wanted. Under the search
+rules it bids for all the cargo its coin sizes, whatever that crew can move, and what it cannot carry stands where it
+was bought. Under the clearing rules it bids only for the cargo the hours still free can carry
+(`within_the_crew_hired`), and the hours of the cargo left unbid join next year's plan (`left_unbid`, `with_unbid`),
+so the crew grows to the trade it wants and no cargo is bought to be sold back. Plain functions of built inputs."""
 import math
 from typing import Callable, Dict, Iterable, Mapping, Optional, Sequence, Tuple
 
@@ -85,6 +91,73 @@ def by_the_hours_the_stocks_need(stocks: Sequence[Stock], _plan_share_by_tile: M
     return {stock: min([cut[key] for key in needed.get(stock, {}) if key in cut], default=1.0) for stock in stocks}
 
 
+def hours_left_for_new_cargo(hours_hired: Optional[Mapping[str, float]], hours_needed: Mapping[Stock, Mapping[str, float]],
+                             share_kept_by_stock: Mapping[Stock, float]) -> Optional[Dict[str, float]]:
+    """{crew key: hours} of the crew hired that the stocks kept for routes leave free: the hours hired less what each
+    stock needs times the share of it that is kept (the whole of a stock no share is named for), never below nothing.
+    None where there is no plan to hire for yet (`hours_hired` None)."""
+    if hours_hired is None:
+        return None
+    left = {key: max(0.0, hours) for key, hours in hours_hired.items()}
+    for stock in sorted(hours_needed):
+        kept = share_kept_by_stock.get(stock, 1.0)
+        for key, hours in hours_needed[stock].items():
+            if key in left:
+                left[key] = max(0.0, left[key] - hours * kept)
+    return left
+
+
+def all_the_cargo_sized(rows: int, _hours_by_row: Callable[[], Sequence[Mapping[str, float]]],
+                        _hours_left: Callable[[], Optional[Mapping[str, float]]]) -> list:
+    """The share of each sized row's cargo that is bid for: all of it."""
+    return [1.0] * rows
+
+
+def within_the_crew_hired(rows: int, hours_by_row: Callable[[], Sequence[Mapping[str, float]]],
+                          hours_left: Callable[[], Optional[Mapping[str, float]]]) -> list:
+    """The share of each sized row's cargo that is bid for: where the rows together need more hours of a crew key than
+    are left of it (`hours_left_for_new_cargo`), the share left; a row takes the least over the keys its haul needs,
+    and all of it where none is short. All of every row where there is no plan to hire for yet (`hours_left()` None)."""
+    left = hours_left()
+    if left is None:
+        return [1.0] * rows
+    needed = hours_by_row()
+    totals: Dict[str, float] = {}
+    for by_key in needed:
+        for key, hours in by_key.items():
+            totals[key] = totals.get(key, 0.0) + hours
+    cut = {key: left.get(key, 0.0) / total for key, total in totals.items() if total > left.get(key, 0.0)}
+    return [min([cut[key] for key in by_key if key in cut], default=1.0) for by_key in needed]
+
+
+def left_unbid(hours_by_row: Sequence[Mapping[str, float]], shares: Sequence[float],
+               carriage_money_by_row: Sequence[float]) -> Tuple[Dict[str, float], Dict[str, float]]:
+    """({crew key: hours}, {crew key: carriage money}) of the cargo not bid for: of each row, the share cut times the
+    hours its haul needs of each key, and times its carriage money shared over the keys by their hours."""
+    hours_unbid: Dict[str, float] = {}
+    money_unbid: Dict[str, float] = {}
+    for by_key, share, money in zip(hours_by_row, shares, carriage_money_by_row):
+        cut = 1.0 - share
+        row_hours = math.fsum(by_key.values())
+        if cut <= 0.0 or row_hours <= 0.0:
+            continue
+        for key, hours in by_key.items():
+            hours_unbid[key] = hours_unbid.get(key, 0.0) + cut * hours
+            money_unbid[key] = money_unbid.get(key, 0.0) + cut * money * hours / row_hours
+    return hours_unbid, money_unbid
+
+
+def with_unbid(wanted: Mapping[str, float], unbid: Mapping[str, float]) -> Mapping[str, float]:
+    """A year's figures by crew key (the hours its shipments wanted, or their carriage money) with those of the cargo
+    left unbid added; the figures themselves where nothing was left unbid."""
+    if not unbid:
+        return wanted
+    found = dict(wanted)
+    for key, value in unbid.items():
+        found[key] = found.get(key, 0.0) + value
+    return found
+
+
 def kept_whole(_units_held: float, _share_crewed: float, _room_at_destinations: float) -> float:
