+def ordered_with_crew(cash, hours_hired, rule=within_the_crew_hired):
+    """(the merchant, its orders) on the two-tile world with nothing held: salt at two a unit on `a` sells at five on `b`, a tonne a unit,
+    two carter hours a tonne; `hours_hired` is what it hired this year by crew key (None: it has no plan yet)."""
+    carriage, area_map, area_a, area_b = world()
+    who = merchant()
+    who.expected_prices = {("salt", area_a["salt"]): 2.0, ("salt", area_b["salt"]): 5.0}
+    who.expected_volumes = {("salt", area_b["salt"]): 100.0}
+    orders = merchants.orders(who, View({}), carriage, area_map, cash, {}, SPECS, 0.0, cargo_the_crew_carries=rule,
+                              crew_hours_per_tonne=two_hours_a_tonne, crew_hours_hired=hours_hired)
+    return who, orders
+
+
+class OrdersWithinTheCrewHired(unittest.TestCase):
+    def test_with_no_plan_yet_it_bids_for_all_it_sized_and_leaves_nothing_unbid(self):
+        who, orders = ordered_with_crew(30.0, None)
+        unlimited = bid_for(orders)
+        self.assertGreater(unlimited, 5.0)
+        self.assertEqual((who.crew_hours_unbid, who.crew_money_unbid), ({}, {}))
+
+    def test_it_bids_for_the_cargo_its_hired_hours_carry_and_keeps_the_rest_for_the_plan(self):
+        _who, unlimited = ordered_with_crew(30.0, None)
+        sized = bid_for(unlimited)
+        who, orders = ordered_with_crew(30.0, {"carter|a": 10.0})
+        self.assertAlmostEqual(bid_for(orders), 5.0)
+        self.assertAlmostEqual(who.crew_hours_unbid["carter|a"], (sized - 5.0) * 2.0)
+        self.assertAlmostEqual(who.crew_money_unbid["carter|a"], (sized - 5.0) * CARRIAGE_PER_UNIT)
+        self.assertEqual(who.routes[("salt", "a")][0][:2], ("b", who.routes[("salt", "a")][0][1]))
+
+    def test_with_a_plan_and_no_crew_hired_it_bids_for_nothing_and_wants_the_hours_next_year(self):
+        _who, unlimited = ordered_with_crew(30.0, None)
+        who, orders = ordered_with_crew(30.0, {})
+        self.assertEqual(orders.bids, ())
+        self.assertAlmostEqual(who.crew_hours_unbid["carter|a"], bid_for(unlimited) * 2.0)
+
+    def test_hours_enough_for_the_cargo_change_nothing(self):
+        _who, unlimited = ordered_with_crew(30.0, None)
+        who, orders = ordered_with_crew(30.0, {"carter|a": 1000.0})
+        self.assertEqual(bid_for(orders), bid_for(unlimited))
+        self.assertEqual(who.crew_hours_unbid, {})
+
+    def test_under_the_search_rule_the_hours_hired_do_not_hold_the_cargo(self):
+        _who, unlimited = ordered_with_crew(30.0, None)
+        who, orders = ordered_with_crew(30.0, {"carter|a": 10.0}, rule=all_the_cargo_sized)
+        self.assertEqual(bid_for(orders), bid_for(unlimited))
+        self.assertEqual(who.crew_hours_unbid, {})
+
