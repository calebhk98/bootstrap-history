+def resting_producer_purse(recipe, capacity_runs: float, expected_sales: float, prices: Mapping[str, float],
+                           wages: Mapping[str, float], rent_per_run: float = 0.0) -> float:
+    """The coin a producer holds at the end of a year it repeats: what the year's close keeps back before it pays its
+    owners the rest (`firm_finance.cash_to_keep`). That is next year's working capital (a year of the whole capacity's
+    variable cost, `producers_close.working_capital_target`), the plant that wears out in a year at what it costs to
+    rebuild, and the buffer on the running costs of the runs it works (their variable cost and rent). A producer
+    opened with less pays its owners only a share of what it earns until it has saved the difference, and the
+    opening's incomes count all of it as paid. Nothing when a run cannot be priced."""
+    working = producers_close.working_capital_target(recipe, capacity_runs, prices, wages)
+    run_cost = unit_cost.variable_cost_per_run(recipe, prices, wages, rent_per_run)
+    if working <= 0.0 or not math.isfinite(run_cost):
+        return 0.0
+    rebuilt = 0.0
+    if recipe.plant_life_years > 0.0:
+        plant = unit_cost.plant_value_per_run(recipe, prices, wages)
+        rebuilt = capacity_runs / recipe.plant_life_years * plant if math.isfinite(plant) else 0.0
+    return firm_finance.cash_to_keep(working, 0.0, rebuilt, max(0.0, expected_sales) * run_cost)
+
