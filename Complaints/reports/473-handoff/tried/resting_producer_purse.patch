 class RestingPurseTests(unittest.TestCase):
@@ -47,5 +48,39 @@ class RestingHoursHeldTests(unittest.TestCase):
         self.assertEqual(opening_resting.resting_hours_held({"vale": {"reaper": {"farm_a": 300.0}}}, {}), {})
 
 
+
+# a run takes two of iron at three and ten hours at half: its variable cost is eleven; the plant for a run of yearly
+# capacity is four of timber at five and lasts ten years
+SMITHY = Recipe("smith", {"tool": 1.0}, {"iron": 2.0}, {"smith": 10.0}, plant_goods={"timber": 4.0}, plant_life_years=10.0)
+PRICES = {"iron": 3.0, "timber": 5.0}
+WAGES = {"smith": 0.5}
+RUN_COST = 11.0
+PLANT_PER_RUN = 20.0
+
+
+class ProducerPurseTests(unittest.TestCase):
+    def purse(self, capacity=150.0, expected_sales=100.0, rent=0.0, recipe=SMITHY):
+        return opening_resting.resting_producer_purse(recipe, capacity, expected_sales, PRICES, WAGES, rent)
+
+    def test_a_producer_opens_with_the_cash_the_years_close_keeps_back(self):
+        # the close keeps a year of the capacity's variable cost, the plant that wears in a year and the buffer on the year's running costs
+        working = producers_close.working_capital_target(SMITHY, 150.0, PRICES, WAGES)
+        self.assertEqual(working, 150.0 * RUN_COST)
+        kept = firm_finance.cash_to_keep(working, 0.0, 150.0 / 10.0 * PLANT_PER_RUN, 100.0 * RUN_COST)
+        self.assertAlmostEqual(self.purse(), kept)
+
+    def test_it_holds_working_capital_for_its_whole_capacity_not_only_the_runs_it_expects_to_sell(self):
+        self.assertAlmostEqual(self.purse(capacity=150.0) - self.purse(capacity=100.0), 50.0 * RUN_COST + 5.0 * PLANT_PER_RUN)
+
+    def test_the_rent_of_the_runs_it_works_is_in_the_running_costs_the_buffer_covers(self):
+        self.assertAlmostEqual(self.purse(rent=4.0) - self.purse(), firm_finance.CASH_BUFFER_SHARE_OF_COSTS * 100.0 * 4.0)
+
+    def test_a_producer_with_no_plant_keeps_nothing_back_to_rebuild(self):
+        hands = Recipe("dig", {"clay": 1.0}, {}, {"smith": 10.0})
+        self.assertAlmostEqual(self.purse(recipe=hands), 150.0 * 5.0 + firm_finance.CASH_BUFFER_SHARE_OF_COSTS * 100.0 * 5.0)
+
+    def test_a_run_that_cannot_be_priced_opens_with_nothing(self):
+        self.assertEqual(opening_resting.resting_producer_purse(SMITHY, 150.0, 100.0, {"timber": 5.0}, WAGES), 0.0)
+
 if __name__ == "__main__":
     unittest.main()
