diff --git a/sim/tests/test_merchant_expectations.py b/sim/tests/test_merchant_expectations.py
new file mode 100644
index 00000000..96c83f9a
--- /dev/null
+++ b/sim/tests/test_merchant_expectations.py
@@ -0,0 +1,50 @@
+"""merchant_expectations: how far a merchant's expected prices move toward the year's in a year. The search rules keep the merchants' own
+speed; the clearing rules move them the share producers' expectations move. The rules, then `merchants.learn_year` given a speed."""
+
+QUICK_TOPIC = True
+
+import unittest
+
+from sim.economy import close_pack, merchant_expectations, merchants, merchants_news, rule_sets
+from sim.tests.test_economy_merchants import merchant, world
+
+
+class Rules(unittest.TestCase):
+    def test_which_rule_each_set_runs(self):
+        self.assertIs(rule_sets.RULE_SETS["search"].merchant_expectation_speed, merchant_expectations.as_a_merchant_sees_its_markets)
+        self.assertIs(rule_sets.RULE_SETS["clearing"].merchant_expectation_speed, merchant_expectations.as_producers_move_theirs)
+
+    def test_what_each_rule_gives(self):
+        self.assertEqual(merchant_expectations.as_a_merchant_sees_its_markets(), merchants.MERCHANT_EXPECTATION_SPEED)
+        self.assertEqual(merchant_expectations.as_producers_move_theirs(), close_pack.EXPECTATION_SHARE_MOVED_UNDER_CLEARING)
+        self.assertLess(merchant_expectations.as_producers_move_theirs(), merchant_expectations.as_a_merchant_sees_its_markets())
+
+
+def expected_after_a_year(speed=None):
+    """What a merchant that expected salt at two on its home tile expects after a year in which it cleared at four."""
+    carriage, _area_map, area_a, _area_b = world()
+    who = merchant()
+    key = ("salt", area_a["salt"])
+    who.expected_prices = {key: 2.0}
+    news = merchants_news.YearNews({key: 4.0}, {key: 100.0}, {key: "a"})
+    store, _row = who._table()
+    store.tables.merchant_table = store       # the table `learn_year` finds from the market tables is this merchant's
+    if speed is None:
+        merchants.learn_year(store.tables, news, carriage)
+    else:
+        merchants.learn_year(store.tables, news, carriage, speed)
+    return who.expected_prices[key]
+
+
+class LearnYear(unittest.TestCase):
+    def test_with_no_speed_named_the_merchants_own_speed_moves_the_expectation(self):
+        self.assertAlmostEqual(expected_after_a_year(), 2.0 + merchants.MERCHANT_EXPECTATION_SPEED * 2.0)
+
+    def test_the_expectation_moves_the_share_of_the_gap_the_speed_names(self):
+        self.assertAlmostEqual(expected_after_a_year(0.2), 2.4)
+        self.assertAlmostEqual(expected_after_a_year(1.0), 4.0)
+        self.assertAlmostEqual(expected_after_a_year(0.0), 2.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
