+"""How far a merchant's expected prices and volumes move toward the year's in a year (the rule sets' `merchant_expectation_speed`).
+
+A merchant lays its coin out on the routes that pay best at the prices it expects. Where those follow the last year
+closely, the route that paid best last year takes the coin this year, its source clears dearer and its market cheaper
+for it, and next year the coin goes elsewhere: the merchant's buying jumps between source tiles from year to year, its
+carriers (hired on last year's routes) stand on the wrong tiles, and a part of each market it serves comes and goes.
+Under the clearing rules a merchant's expectations move the share of the gap that producers' do, so the routes it
+chooses follow what a market has done over some years."""
+from . import close_pack, merchants
+
+
+def as_a_merchant_sees_its_markets() -> float:
+    """The share of the gap between what a merchant expected and what the year showed that it closes: the merchants' own."""
+    return merchants.MERCHANT_EXPECTATION_SPEED
+
+
+def as_producers_move_theirs() -> float:
+    """The share of the gap between what a merchant expected and what the year showed that it closes: the share a
+    producer's expected prices move under the clearing rules."""
+    return close_pack.EXPECTATION_SHARE_MOVED_UNDER_CLEARING
