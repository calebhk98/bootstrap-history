+"""Each merchant by year: coin, the worth of the goods it holds (at the price of the market where they lie), its routes, the staple it
+routes into each unfed tile, its debts, and the tonnes carried. Usage: python3 merchant_book_probe.py <civ> <years> <good>"""
+import random, sys
+from collections import defaultdict
+from sim.economy import api as economy_api
+from sim.economy.market_memory import market_key
+from sim.engine.ui_port import Sim, load, load_civ
+from sim.markets import spin_up_stages
+
+civ, years, good = sys.argv[1], int(sys.argv[2]), sys.argv[3]
+_t, _p, nodes, _w, _g = load()
+game = Sim(nodes, [], random.Random(1), events=False, manual=True, civ=load_civ(civ))
+setup = game.view("agent_opening_setup")()
+economy = economy_api.blank_economy(setup)
+economy_api.begin_spin_up(economy)
+inputs = spin_up_stages.year_inputs(economy)
+area_map = setup.area_map()
+record = economy.record
+money = setup.currency_id
+book = record.book
+print("merchants", len(record.merchants), "fields", [name for name in dir(next(iter(record.merchants.values()))) if not name.startswith("_")][:30])
+for year in range(years):
+    outcome = economy.step(inputs)
+    tonnes = sum(band.tonnes if hasattr(band, "tonnes") else band["tonnes"] for band in outcome.merchant_routes)
+    for key, merchant in record.merchants.items():
+        held = sum(book.stock(merchant.agent_id, good, tile) for tile in setup.tiles)
+        into = defaultdict(float)
+        for (item, source), legs in merchant.routes.items():
+            if item == good:
+                for leg in legs:
+                    into[leg[0]] += leg[2]
+        print("year %2d %s coin %10.4g routes %3d tonnes carried %8.4g holds %9.4g of the staple | %s routed into: %s | hunger %.1f%%" % (
+            year, key, book.balance(merchant.agent_id, money), len(merchant.routes), tonnes, held, good,
+            " ".join("%s %.3g" % (tile, units) for tile, units in sorted(into.items())) or "nowhere",
+            100 * sum(outcome.hunger_by_tile.values()) / (sum(cohort.people for cohort in record.cohorts.values()) * next(
+                need.subsistence_per_person for need in setup.basket_for(setup.capital_tile).needs if need.need_id == setup.hunger_need))))
