@@ -0,0 +1,43 @@
+"""What a trader learns as a market's size: the units its buyers' money would take at the lowest price the good traded at
+anywhere, so a dear or unsupplied market is not a market of no size. Each test calls one function on written-out inputs."""
+QUICK_TOPIC = True
+
+import unittest
+
+from sim.economy import year_close
+
+GRAIN_HOME, GRAIN_FAR, GRAIN_EMPTY = ("grain", "home"), ("grain", "far"), ("grain", "empty")
+
+
+class MarketSizeTests(unittest.TestCase):
+    def test_a_market_at_the_lowest_price_is_the_units_it_took(self):
+        sizes = year_close.market_sizes({GRAIN_HOME: 100.0}, {GRAIN_HOME: 2.0}, {GRAIN_HOME: 2.0}, {})
+        self.assertEqual(sizes, {GRAIN_HOME: 100.0})
+
+    def test_a_market_paying_three_times_the_lowest_price_counts_three_times_its_units(self):
+        # the far market's buyers spent sixty on ten units; at the home price that money takes thirty
+        sizes = year_close.market_sizes({GRAIN_HOME: 100.0, GRAIN_FAR: 10.0}, {GRAIN_HOME: 2.0, GRAIN_FAR: 6.0},
+                                        {GRAIN_HOME: 2.0, GRAIN_FAR: 6.0}, {})
+        self.assertEqual(sizes, {GRAIN_HOME: 100.0, GRAIN_FAR: 30.0})
+
+    def test_a_market_with_buyers_and_nothing_delivered_counts_what_they_asked_for(self):
+        # nothing traded there (no cleared price); it remembers four, twice the home price, and buyers asked for fifteen
+        sizes = year_close.market_sizes({GRAIN_HOME: 100.0, GRAIN_EMPTY: 0.0}, {GRAIN_HOME: 2.0, GRAIN_EMPTY: None},
+                                        {GRAIN_HOME: 2.0, GRAIN_EMPTY: 4.0}, {GRAIN_EMPTY: 15.0})
+        self.assertEqual(sizes, {GRAIN_HOME: 100.0, GRAIN_EMPTY: 30.0})
+
+    def test_units_asked_for_in_vain_count_beside_those_delivered(self):
+        sizes = year_close.market_sizes({GRAIN_HOME: 100.0}, {GRAIN_HOME: 2.0}, {GRAIN_HOME: 2.0}, {GRAIN_HOME: 25.0})
+        self.assertEqual(sizes, {GRAIN_HOME: 125.0})
+
+    def test_a_good_that_traded_nowhere_is_the_units_asked_for(self):
+        sizes = year_close.market_sizes({GRAIN_EMPTY: 0.0}, {GRAIN_EMPTY: None}, {GRAIN_EMPTY: 4.0}, {GRAIN_EMPTY: 15.0})
+        self.assertEqual(sizes, {GRAIN_EMPTY: 15.0})
+
+    def test_a_market_with_no_price_remembered_is_the_units_it_took(self):
+        sizes = year_close.market_sizes({GRAIN_HOME: 100.0, GRAIN_FAR: 10.0}, {GRAIN_HOME: 2.0, GRAIN_FAR: None}, {GRAIN_HOME: 2.0}, {})
+        self.assertEqual(sizes, {GRAIN_HOME: 100.0, GRAIN_FAR: 10.0})
+
+
+if __name__ == "__main__":
+    unittest.main()
