+def market_sizes(volumes, cleared, prices, unmet):
+    """What a trader learns as each market's size, by (good, area): the units its buyers took (`volumes`) and asked for in
+    vain (`unmet`), counted at the lowest price the good traded at in any area this year (`cleared`: the traded price, None
+    where nothing traded). A market that pays several times that price, or remembers such a price with nothing on offer
+    (`prices`), would take more units at a price nearer what the good costs elsewhere: what a trader shares in is the
+    buyers' money, which at the market's own price buys few units. A good that traded nowhere, and a market with no
+    price remembered, count their units as they are."""
+    lowest = {}
+    for (good, _area), price in cleared.items():
+        if price is not None and price > 0.0 and (good not in lowest or price < lowest[good]):
+            lowest[good] = price
+    sizes = {}
+    for key in sorted(set(volumes) | set(unmet)):
+        units = volumes.get(key, 0.0) + unmet.get(key, 0.0)
+        here, base = prices.get(key), lowest.get(key[0])
+        sizes[key] = units * max(1.0, here / base) if here is not None and base is not None else units
+    return sizes
+
