@@ -0,0 +1,34 @@
+"""In each market area of a good that had buyers and nothing on offer: what the good would fetch against the food on offer there
+(ask_ceiling.alternative_ceiling at the area's offered prices), beside its remembered price, the price where it trades, and the
+offered prices of the need's other goods. Usage: python3 worth_probe.py <civ> <years> <good>"""
+import random, sys
+from sim.economy import api as economy_api
+from sim.economy.ask_ceiling import alternative_ceiling
+from sim.economy.market_memory import market_key
+from sim.engine.ui_port import Sim, load, load_civ
+from sim.markets import spin_up_stages
+
+civ, years, good = sys.argv[1], int(sys.argv[2]), sys.argv[3]
+_t, _p, nodes, _w, _g = load()
+game = Sim(nodes, [], random.Random(1), events=False, manual=True, civ=load_civ(civ))
+setup = game.view("agent_opening_setup")()
+economy = economy_api.blank_economy(setup)
+economy_api.begin_spin_up(economy)
+inputs = spin_up_stages.year_inputs(economy)
+area_map = setup.area_map()
+record = economy.record
+for year in range(years):
+    economy.step(inputs)
+    print("year", year)
+    for area in area_map.areas(good):
+        key = market_key(good, area.area_id)
+        tile = area.anchor_tile
+        def offered(other):
+            return record.memory.offered_price(market_key(other, area_map.area_of(other, tile))) if other in area_map.goods() else None
+        ceiling = alternative_ceiling(good, setup.basket_for(tile).needs, offered, lambda other: None)
+        need = next(each for each in setup.basket_for(tile).needs if each.need_id == setup.hunger_need)
+        on_offer = {other: round(offered(other), 3) for other, _effect in need.goods if other != good and offered(other)}
+        print("   %-14s delivered %9.3g unmet %9.3g remembered %s (%s) worth against what is on offer %s | on offer: %s" % (
+            area.area_id, record.goods.volumes.get(key, 0.0) or 0.0, record.goods.unmet.get(key, 0.0) or 0.0,
+            None if record.memory.prices.get(key) is None else round(record.memory.prices.get(key), 3), record.memory.price_kind(key),
+            None if ceiling.price is None else round(ceiling.price, 3), on_offer))
