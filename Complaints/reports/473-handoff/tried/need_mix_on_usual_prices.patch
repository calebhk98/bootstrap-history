+++ b/sim/economy/need_mix_prices.py
@@ -0,0 +1,47 @@
+"""The prices a household chooses the mix of goods within a need on (the rule sets' `need_mix_on_usual_prices`).
+
+A household that shares its spending on a need between the goods that serve it by last year's prices moves the shares every year: the good
+that cleared cheap is asked for more, clears dear, and is dropped the year after, so two substitutes trade a budget back and forth and
+neither price rests. Chosen on what each good has usually cost (`MarketMemory.usual_prices`, a slow average of its price), the mix follows a
+lasting change of price over the years and passes over one year's. The goods' own prices, what a unit of the need costs at them, the bids
+and the ceilings stay those on offer; a good with no usual price is weighed at its offered price; a need re-mixed for quality
+(`need_basket.with_quality_reach`) is re-mixed on the offered prices."""
+from typing import Dict, Optional
+
+from .priced_reads import usual_prices_for
+
+NO_MATRIX = object()     # the mix is chosen on usual prices and the view keeps no matrix of them: the caller prices its asks one at a time
+
+
+def chosen_on_the_offered_prices() -> bool:
+    """The mix is chosen on the prices on offer."""
+    return False
+
+
+def chosen_on_the_usual_prices() -> bool:
+    """The mix is chosen on what each good has usually cost."""
+    return True
+
+
+def _on_usual_prices(view) -> bool:
+    """Whether the rule set of the view's setup has households choose on usual prices (the default set where the view has no setup)."""
+    from . import rule_sets      # the rule sets import this module for the two rules above
+    return rule_sets.of(getattr(view, "setup", None)).need_mix_on_usual_prices()
+
+
+def matrix_for(view, tiles, names):
+    """(tile by good) the prices the view's households choose a need's mix on, NaN where a good has none on a tile; None where they
+    choose on the prices on offer, `NO_MATRIX` where the view keeps no matrix of them."""
+    if not _on_usual_prices(view):
+        return None
+    matrix_of = getattr(view, "usual_price_matrix", None)
+    matrix = None if matrix_of is None else matrix_of(tiles, names)
+    return NO_MATRIX if matrix is None else matrix
+
+
+def prices_for(view, tile, goods) -> Optional[Dict[str, Optional[float]]]:
+    """{good: the price the view's households choose a need's mix on, None for none} on `tile`; None where they choose on the prices
+    on offer."""
+    if not _on_usual_prices(view):
+        return None
+    return usual_prices_for(view, tile, goods)
