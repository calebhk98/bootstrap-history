diff --git a/sim/tests/test_need_mix_prices.py b/sim/tests/test_need_mix_prices.py
new file mode 100644
index 00000000..4531f8bd
--- /dev/null
+++ b/sim/tests/test_need_mix_prices.py
@@ -0,0 +1,160 @@
+"""The prices a household chooses the mix of goods within a need on (sim/economy/need_mix_prices.py): the search rules choose on the prices
+on offer, the clearing rules on what each good has usually cost, and the goods' own prices and the cost of a unit of the need stay at the
+offer. The kernel's pricing equals the Python's bit for bit. No game."""
+
+QUICK_TOPIC = True
+
+import random
+import types
+import unittest
+
+import numpy
+
+from sim.economy import need_mix_prices, priced_needs, rule_sets
+from sim.world import need_basket
+from sim.world.need_basket import Basket, NeedSpec
+
+TOOLS = NeedSpec("implements", 0.0, 0.2, (("iron", 1.0), ("steel", 2.0)))
+EXPONENT = -1.0      # one minus a substitution elasticity of two
+
+
+def shares_of(priced):
+    return {good: share for good, _price, _effect, share in priced.goods}
+
+
+class PricedNeedOnMixPrices(unittest.TestCase):
+    def test_the_shares_are_those_of_the_mix_prices(self):
+        at_mix_prices = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0, "steel": 4.0}.get)
+        chosen = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0, "steel": 2.0}.get, mix_price_of={"iron": 1.0, "steel": 4.0}.get)
+        self.assertEqual(shares_of(chosen), shares_of(at_mix_prices))
+
+    def test_a_year_of_cheap_steel_moves_no_spending_when_the_usual_prices_stand(self):
+        usual = {"iron": 1.0, "steel": 4.0}
+        dear = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0, "steel": 4.4}.get, mix_price_of=usual.get)
+        cheap = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0, "steel": 3.6}.get, mix_price_of=usual.get)
+        self.assertEqual(shares_of(dear), shares_of(cheap))
+
+    def test_the_goods_keep_the_offered_prices_and_the_index_is_what_the_mix_costs_at_them(self):
+        chosen = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0, "steel": 2.0}.get, mix_price_of={"iron": 1.0, "steel": 4.0}.get)
+        self.assertEqual([price for _good, price, _effect, _share in chosen.goods], [1.0, 2.0])
+        units_per_money = sum(share * effect / price for _good, price, effect, share in chosen.goods)
+        self.assertAlmostEqual(chosen.price_index, 1.0 / units_per_money)
+
+    def test_a_good_with_no_mix_price_is_weighed_at_its_offered_price(self):
+        plain = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0, "steel": 2.0}.get)
+        for missing in ({}, {"steel": None}, {"steel": 0.0}, {"steel": float("nan")}):
+            chosen = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0, "steel": 2.0}.get, mix_price_of=dict(missing, iron=1.0).get)
+            self.assertEqual(chosen.goods, plain.goods)
+
+    def test_mix_prices_equal_to_the_offered_ones_change_nothing(self):
+        prices = {"iron": 1.3, "steel": 2.9}
+        plain = need_basket.priced_need(TOOLS, EXPONENT, prices.get)
+        chosen = need_basket.priced_need(TOOLS, EXPONENT, prices.get, mix_price_of=prices.get)
+        self.assertEqual((chosen.goods, chosen.price_index, chosen.ceilings), (plain.goods, plain.price_index, plain.ceilings))
+
+    def test_a_good_not_on_offer_is_out_of_the_mix_whatever_it_usually_cost(self):
+        chosen = need_basket.priced_need(TOOLS, EXPONENT, {"iron": 1.0}.get, mix_price_of={"iron": 1.0, "steel": 0.01}.get)
+        self.assertEqual(shares_of(chosen), {"iron": 1.0})
+
+
+def priced_both_ways(test, specs, prices, mix_prices, substitution=2.0):
+    """The kernel's priced needs and the Python's for the same needs, offered prices and mix prices: equal field by field, exactly."""
+    basket = Basket(tuple(specs), substitution, {})
+    expected = [priced for priced in (need_basket.priced_need(spec, 1.0 - substitution, prices.get, mix_price_of=mix_prices.get) for spec in specs)
+                if priced is not None]
+    got = list(priced_needs.priced_needs_at(basket, prices, mix_prices=mix_prices))
+    test.assertEqual(len(got), len(expected))
+    for left, right in zip(got, expected):
+        test.assertEqual(left.spec, right.spec)
+        test.assertEqual(left.price_index, right.price_index)
+        test.assertEqual(left.goods, right.goods)
+        test.assertEqual(left.ceilings, right.ceilings)
+    return expected
+
+
+class KernelAgainstThePython(unittest.TestCase):
+    def test_two_goods_with_a_usual_price_each(self):
+        (need,) = priced_both_ways(self, [TOOLS], {"iron": 1.0, "steel": 2.0}, {"iron": 1.1, "steel": 4.0})
+        self.assertAlmostEqual(sum(shares_of(need).values()), 1.0)
+
+    def test_a_good_with_no_usual_price_and_a_usual_price_for_a_good_not_on_offer(self):
+        wide = NeedSpec("implements", 0.0, 0.2, (("iron", 1.0), ("steel", 2.0), ("bronze", 1.0)))
+        (need,) = priced_both_ways(self, [wide], {"iron": 1.0, "steel": 2.0}, {"steel": 4.0, "bronze": 0.5})
+        self.assertEqual(sorted(shares_of(need)), ["iron", "steel"])
+
+    def test_with_a_share_limit_that_binds(self):
+        limited = NeedSpec("food", 200.0, 0.5, (("grain", 1.0), ("tallow", 2.0)), (("tallow", 0.35),))
+        priced_both_ways(self, [limited], {"grain": 1.0, "tallow": 0.2}, {"grain": 1.4, "tallow": 0.1})
+
+    def test_random_needs_prices_and_usual_prices(self):
+        rng = random.Random(11)
+        for _case in range(60):
+            goods = ["good%d" % number for number in range(rng.randint(2, 7))]
+            specs = []
+            for number in range(rng.randint(1, 4)):
+                served = rng.sample(goods, rng.randint(1, len(goods)))
+                limits = tuple((good, rng.uniform(0.1, 0.9)) for good in served if rng.random() < 0.2)
+                specs.append(NeedSpec("need%d" % number, rng.choice([0.0, 50.0]), rng.uniform(0.05, 0.5),
+                                      tuple((good, rng.uniform(0.2, 3.0)) for good in served), limits))
+            prices = {good: rng.uniform(0.1, 9.0) for good in goods if rng.random() < 0.85}
+            mix_prices = {good: rng.uniform(0.1, 9.0) for good in goods if rng.random() < 0.7}
+            priced_both_ways(self, specs, prices, mix_prices, substitution=rng.choice([1.5, 2.0, 3.0]))
+
+
+class StandInView:
+    """A view that answers only what the mix-price reads ask of one."""
+
+    def __init__(self, rule_set, usual):
+        self.setup = types.SimpleNamespace(rule_set=rule_set)
+        self.usual = usual       # {(good, tile): price}
+
+    def usual_price_matrix(self, tiles, names):
+        return numpy.array([[self.usual.get((good, tile), numpy.nan) for good in names] for tile in tiles])
+
+    def area_of(self, _good, tile):
+        return tile
+
+    def usual_price(self, good, area):
+        return self.usual.get((good, area))
+
+
+class MixPricesOfAView(unittest.TestCase):
+    USUAL = {("iron", "north"): 1.5, ("steel", "north"): 4.0, ("iron", "south"): 1.25}
+
+    def test_the_search_rules_choose_on_the_offered_prices(self):
+        view = StandInView("search", self.USUAL)
+        self.assertIsNone(need_mix_prices.matrix_for(view, ["north", "south"], ["iron", "steel"]))
+        self.assertIsNone(need_mix_prices.prices_for(view, "north", ["iron", "steel"]))
+
+    def test_the_clearing_rules_choose_on_the_usual_prices_tile_by_good(self):
+        view = StandInView("clearing", self.USUAL)
+        matrix = need_mix_prices.matrix_for(view, ["north", "south"], ["iron", "steel"])
+        self.assertEqual(matrix[0].tolist(), [1.5, 4.0])
+        self.assertEqual(matrix[1, 0], 1.25)
+        self.assertTrue(numpy.isnan(matrix[1, 1]))
+
+    def test_the_clearing_rules_usual_prices_of_one_tile(self):
+        view = StandInView("clearing", self.USUAL)
+        self.assertEqual(need_mix_prices.prices_for(view, "south", ["iron", "steel"]), {"iron": 1.25, "steel": None})
+
+    def test_a_view_with_no_setup_chooses_on_the_offered_prices(self):
+        self.assertIsNone(need_mix_prices.matrix_for(object(), ["north"], ["iron"]))
+        self.assertIsNone(need_mix_prices.prices_for(object(), "north", ["iron"]))
+
+    def test_a_view_that_keeps_no_matrix_of_usual_prices_cannot_answer_for_a_batch(self):
+        view = types.SimpleNamespace(setup=types.SimpleNamespace(rule_set="clearing"))
+        self.assertIs(need_mix_prices.matrix_for(view, ["north"], ["iron"]), need_mix_prices.NO_MATRIX)
+
+
+class Rules(unittest.TestCase):
+    def test_which_rule_each_set_runs(self):
+        self.assertIs(rule_sets.RULE_SETS["search"].need_mix_on_usual_prices, need_mix_prices.chosen_on_the_offered_prices)
+        self.assertIs(rule_sets.RULE_SETS["clearing"].need_mix_on_usual_prices, need_mix_prices.chosen_on_the_usual_prices)
+
+    def test_what_each_rule_says(self):
+        self.assertFalse(need_mix_prices.chosen_on_the_offered_prices())
+        self.assertTrue(need_mix_prices.chosen_on_the_usual_prices())
+
+
+if __name__ == "__main__":
+    unittest.main()
