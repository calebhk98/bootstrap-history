+POT = "pot_kg"
+# a kiln: a tonne and a half of fuel fires half a tonne of pots; fuel is felled where the timber stands
+KILN = Recipe("kiln", {POT: 500.0}, {FUEL: 1500.0}, {"potter": 10.0})
+FELL = Recipe("fell", {FUEL: 1000.0}, {}, {"labourer": 1.0}, site_bound=True)
+
+
+class Apart:
+    def cost_per_tonne(self, source, destination):
+        return 0.0 if source == destination else 100.0
+
+
+def pot_area(tile):
+    return MarketArea("pot@" + tile, POT, (tile,), tile)       # pots are too cheap to carry: each tile is its own market
+
+
+class EachAreaMakesItsOwnTests(unittest.TestCase):
+    def placed(self, felling_runs, wanted):
+        """Kiln runs by tile, with `felling_runs` of felling capacity on each tile and `wanted` kiln runs for each tile's pot market."""
+        fellers = [Producer("producer:fell@" + tile, "owner", "fell", tile, runs) for tile, runs in felling_runs.items()]
+        setup, record = world(fellers, {"kiln": KILN, "fell": FELL}, {"north": 1000.0, "south": 1000.0})
+        setup.specs[POT] = GoodSpec(POT, 1.0, 0.0, 0.0, "x")
+        return location_inputs.place_oriented(setup, record, Areas(), Apart(), KILN, {FUEL: "fell"},
+                                              [(pot_area(tile), runs) for tile, runs in wanted.items()], ["north", "south"])
+
+    def test_an_area_that_fells_its_own_fuel_fires_its_own_pots(self):
+        # the north is the cheaper tile to serve both from, and each has fuel for far more runs than are wanted
+        self.assertEqual(self.placed({"north": 100.0, "south": 100.0}, {"north": 6.0, "south": 4.0}), {"north": 6.0, "south": 4.0})
+
+    def test_an_area_with_no_fuel_has_its_pots_fired_where_the_fuel_is(self):
+        self.assertEqual(self.placed({"north": 100.0}, {"north": 6.0, "south": 4.0}), {"north": 10.0})
+
+    def test_what_an_areas_own_fuel_cannot_fire_is_fired_where_fuel_is_left(self):
+        # the south fells three runs of fuel, enough for two kiln runs of the four it wants
+        self.assertEqual(self.placed({"north": 100.0, "south": 3.0}, {"north": 6.0, "south": 4.0}), {"north": 8.0, "south": 2.0})
+
+
+PRESS = Recipe("press", {"oil_kg": 200.0}, {"olives_kg": 1000.0}, {"labourer": 10.0})
+GROVE = Recipe("grove", {"olives_kg": 1000.0}, {}, {"labourer": 100.0})
+
+
+class CropsOnlySomeTilesGrowTests(unittest.TestCase):
+    def test_a_recipe_that_cannot_stand_on_every_peopled_tile_is_bound(self):
+        placeable = {"grove": {"south"}, "millet": {"north", "south", "empty"}}
+        self.assertEqual(location_inputs.bound_recipes(placeable, {"north", "south"}), frozenset({"grove"}))
+
+    def test_an_input_only_some_tiles_grow_is_fixed_like_one_a_site_supplies(self):
+        recipes = {"press": PRESS, "grove": GROVE}
+        self.assertEqual(location_inputs.fixed_inputs(PRESS, {"olives_kg": "grove"}, recipes, {}, frozenset({"grove"})),
+                         {"olives_kg": "grove"})
+
+    def test_an_input_every_tile_can_grow_pulls_nothing(self):
+        recipes = {"press": PRESS, "grove": GROVE}
+        self.assertEqual(location_inputs.fixed_inputs(PRESS, {"olives_kg": "grove"}, recipes, {}), {})
+
+    def test_bound_recipes_are_placed_before_the_recipes_that_use_what_they_make(self):
+        setup = SimpleNamespace(opening_prices={"oil_kg": 5.0, "olives_kg": 1.0}, site_limits=(), specs={})
+        order = opening._placement_order({"press": 1.0, "grove": 1.0}, {"press": PRESS, "grove": GROVE}, setup, frozenset({"grove"}))
+        self.assertEqual(order, ["grove", "press"])
+
+    def test_an_unbound_supplier_is_still_placed_after_its_users(self):
+        setup = SimpleNamespace(opening_prices={"oil_kg": 5.0, "olives_kg": 1.0}, site_limits=(), specs={})
+        order = opening._placement_order({"press": 1.0, "grove": 1.0}, {"press": PRESS, "grove": GROVE}, setup)
+        self.assertEqual(order, ["press", "grove"])
+
