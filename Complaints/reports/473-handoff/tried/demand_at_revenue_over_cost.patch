     return sold + min(1.0, own_capacity / market_capacity) * market_unmet
 
 
+def demand_at_cost(sold_runs: float, revenue_per_run: float, cost_per_run: float, sold_out: bool) -> float:
+    """Runs a producer takes as the year's demand once its market has cleared: the runs it sold, and, when it sold out
+    at prices that brought a run more than the run cost, the runs the buyers' money would have taken at the price that
+    just covers that cost (the runs sold times the run's revenue over its cost: buyers who meet a dearer price spend
+    about the same money on fewer units). A price that clears turns no buyer away, so the price carries what unmet
+    demand told a seller when it did not."""
+    if not sold_out or not (math.isfinite(cost_per_run) and cost_per_run > 0.0) or not revenue_per_run > cost_per_run:
+        return sold_runs
+    return sold_runs * revenue_per_run / cost_per_run
+
