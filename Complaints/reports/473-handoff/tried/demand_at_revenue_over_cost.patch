+def demand_runs(producer, recipe, ledger: YearLedger, book, area_of, prices, market_capacity, cost_per_run: float) -> float:
+    """The runs a producer takes as the year's demand: `runs_sold`, read at a price that covers a run's cost when it sold out
+    above it (`expected_sales.demand_at_cost`). `cost_per_run` is what a run costs it now (its inputs, hands and rent)."""
+    sold = runs_sold(producer, recipe, ledger, book, area_of, prices, market_capacity)
+    priced = [good for good in sorted(recipe.outputs) if prices.get(good) is not None]
+    revenue = math.fsum(recipe.outputs[good] * producer.yield_factor * prices[good] for good in priced)
+    left = math.fsum(book.stock(producer.agent_id, good, producer.tile) * prices[good] for good in priced)
+    taken = math.fsum(ledger.sold.get((producer.agent_id, good), 0.0) * prices[good] for good in priced)
+    return expected_sales.demand_at_cost(sold, revenue, cost_per_run, left <= expected_sales.SOLD_OUT_LEFT_SHARE * taken)
+
