+
+    def test_a_good_reckoned_at_ten_times_its_price_takes_a_tenth_of_the_weight_it_had(self):
+        plain = self.priced_both_ways({"bronze": 4.0, "steel": 4.0}, {})
+        scarce = self.priced_both_ways({"bronze": 4.0, "steel": 4.0}, {"bronze": 10.0})
