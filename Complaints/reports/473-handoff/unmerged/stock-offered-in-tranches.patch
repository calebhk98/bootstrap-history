+    def _in_tranches(self, positions, rate, place, good_row, units, reservation):
+        """The pairs with each held stock split into the lots `inventory.stock_tranches` gives (`stock_tranches.tranche_rows`), in pair order."""
+        if not len(place):
+            return place, good_row, units, reservation
+        columns, spec = self.arrays.producers, self.spec
+        owners = positions[place]
+        sales = columns.expected_sales[owners] * columns.yield_factor[owners] * self._output_per_run()[columns.recipe_row[owners], good_row]
+        source, lot_units, lot_reservation = tranche_rows(units, reservation, sales, float(rate), spec.spoilage[good_row], STOCK_TRANCHES)
+        return place[source], good_row[source], lot_units, lot_reservation
+
+    def _output_per_run(self) -> numpy.ndarray:
+        """Units of each good (column) a run of each recipe (row) makes."""
+        if self._per_run is None:
+            spec = self.spec
+            made = numpy.zeros(spec.has_output.shape)
+            for row in range(len(spec.output_ptr) - 1):
+                for entry in range(spec.output_ptr[row], spec.output_ptr[row + 1]):
+                    made[row, spec.output_good[entry]] = spec.output_per_run[entry]
+            self._per_run = made
+        return self._per_run
