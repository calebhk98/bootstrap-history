diff --git a/sim/economy/stock_tranches.py b/sim/economy/stock_tranches.py
new file mode 100644
index 000000000..87ceec042
--- /dev/null
+++ b/sim/economy/stock_tranches.py
@@ -0,0 +1,38 @@
+"""`inventory.stock_tranches` over the arrays of a turn's offer pairs: every pair's lots as rows, in pair order."""
+import numpy
+
+from sim.jit import njit
+
+KERNEL = {"error_model": "numpy"}
+
+
+@njit(**KERNEL)
+def tranche_rows(stock, reservation, yearly_sales, rate, spoilage, limit):
+    """(source, quantity, reservation): the lots of each pair (`source` is the pair's place), the rule of `inventory.stock_tranches`."""
+    pairs = len(stock)
+    room = pairs * max(limit, 1)
+    source = numpy.empty(room, dtype=numpy.int64)
+    quantity = numpy.empty(room)
+    price = numpy.empty(room)
+    found = 0
+    for pair in range(pairs):
+        if stock[pair] <= 0.0:
+            continue
+        surviving = 1.0 - min(1.0, max(0.0, spoilage[pair]))
+        sales = yearly_sales[pair]
+        if sales <= 0.0 or reservation[pair] <= 0.0 or surviving <= 0.0 or limit < 2 or stock[pair] <= sales:
+            source[found], quantity[found], price[found] = pair, stock[pair], reservation[pair]
+            found += 1
+            continue
+        carried = surviving / (1.0 + max(rate, -0.99))
+        taken = 0.0
+        lots = 0
+        while lots < limit - 1 and stock[pair] - taken > sales:
+            source[found], quantity[found], price[found] = pair, sales, reservation[pair] * carried ** float(lots)
+            found += 1
+            lots += 1
+            taken += sales
+        years_waited = max(0.0, stock[pair] / sales - 1.0)
+        source[found], quantity[found], price[found] = pair, stock[pair] - taken, reservation[pair] * carried ** years_waited
+        found += 1
+    return source[:found], quantity[:found], price[:found]
