@@ -0,0 +1,88 @@
+"""Held stock is offered as a supply curve: the units that would wait years behind the year's expected sales are offered at lower
+reservations than the units that would sell next year, so the quantity offered rises with the price instead of flipping whole."""
+
+QUICK_TOPIC = True
+
+import unittest
+
+import numpy
+
+from sim.economy import inventory, producers, stock_tranches
+from sim.economy.types import Recipe
+from sim.tests.test_economy_idle_producer_holds_stock import View, smelter
+
+SMELT = Recipe("smelt", {"metal": 10.0}, {"ore": 4.0}, {"smith": 1.0})
+
+
+def quantity_offered_at(rows, price):
+    return sum(quantity for quantity, reservation in rows if reservation <= price)
+
+
+class StockTranchesTests(unittest.TestCase):
+    def test_stock_within_a_year_of_sales_is_one_offer_at_the_reservation(self):
+        self.assertEqual(inventory.stock_tranches(2.0, 5.0, 10.0, 0.05, 0.0), [(5.0, 2.0)])
+
+    def test_no_expected_sales_or_no_reservation_leaves_one_offer(self):
+        self.assertEqual(inventory.stock_tranches(2.0, 50.0, 0.0, 0.05, 0.0), [(50.0, 2.0)])
+        self.assertEqual(inventory.stock_tranches(0.0, 50.0, 10.0, 0.05, 0.0), [(50.0, 0.0)])
+        self.assertEqual(inventory.stock_tranches(-1.0, 50.0, 10.0, 0.05, 0.0), [(50.0, -1.0)])
+
+    def test_the_tranches_add_up_to_the_stock_and_the_reservation_falls_down_the_queue(self):
+        rows = inventory.stock_tranches(2.0, 35.0, 10.0, 0.05, 0.1)
+        self.assertAlmostEqual(sum(quantity for quantity, _ in rows), 35.0)
+        self.assertEqual(len(rows), 4)
+        prices = [reservation for _, reservation in rows]
+        self.assertEqual(prices[0], 2.0)
+        self.assertEqual(prices, sorted(prices, reverse=True))
+        self.assertAlmostEqual(prices[-1], inventory.queued_holding_value(2.0, 35.0, 10.0, 0.05, 0.1))
+
+    def test_the_number_of_rows_is_bounded(self):
+        rows = inventory.stock_tranches(2.0, 1.0e6, 10.0, 0.05, 0.0)
+        self.assertEqual(len(rows), inventory.STOCK_TRANCHES)
+        self.assertAlmostEqual(sum(quantity for quantity, _ in rows), 1.0e6)
+
+    def test_the_quantity_offered_never_falls_as_the_price_rises_and_no_step_exceeds_a_year_of_sales(self):
+        rows = inventory.stock_tranches(2.0, 30.0, 10.0, 0.2, 0.0)
+        prices = [0.5 + 0.01 * step for step in range(300)]
+        offered = [quantity_offered_at(rows, price) for price in prices]
+        self.assertEqual(offered, sorted(offered))
+        self.assertEqual(offered[-1], 30.0)
+        self.assertEqual(offered[0], 0.0)
+        steps = [later - earlier for earlier, later in zip(offered, offered[1:])]
+        self.assertLessEqual(max(steps), 10.0 + 1e-9)
+
+    def test_a_price_just_under_the_old_single_reservation_sells_part_of_the_lot(self):
+        rows = inventory.stock_tranches(2.0, 30.0, 10.0, 0.2, 0.0)
+        offered = quantity_offered_at(rows, 2.0 * (1.0 - 1e-6))
+        self.assertGreater(offered, 0.0)
+        self.assertLess(offered, 30.0)
+
+    def test_the_kernel_gives_the_rule_bit_for_bit(self):
+        cases = [(2.0, 35.0, 10.0, 0.05, 0.1), (2.0, 5.0, 10.0, 0.05, 0.0), (0.0, 9.0, 3.0, 0.05, 0.0), (3.5, 1000.0, 7.0, 0.05, 0.2),
+                 (1.0, 40.0, 10.0, 0.05, 0.0), (1.0, 20.0, 0.0, 0.05, 0.0)]
+        reservation, stock, sales, _rate, spoilage = (numpy.array(column) for column in zip(*cases))
+        source, quantity, price = stock_tranches.tranche_rows(stock, reservation, sales, 0.05, spoilage, inventory.STOCK_TRANCHES)
+        for position, case in enumerate(cases):
+            mine = [(float(quantity[row]), float(price[row])) for row in range(len(source)) if source[row] == position]
+            self.assertEqual(mine, inventory.stock_tranches(*case))
+
+
+class ProducerOffersTests(unittest.TestCase):
+    def rows(self, stock):
+        view = View({"metal": 1.0, "ore": 0.01}, {"smith": 0.1})
+        producer = smelter(expected_sales=10.0, expected_prices={"metal": 1.0, "ore": 0.01})
+        return producers.offers(producer, SMELT, view, {"metal": stock}, 0.0, 0.05, {})
+
+    def test_stock_beyond_a_years_sales_is_offered_in_tranches_that_add_up_to_the_stock(self):
+        rows = self.rows(250.0)       # a run makes 10 units and sales are 10 runs a year: 100 units a year
+        self.assertGreater(len(rows), 1)
+        self.assertAlmostEqual(sum(each.quantity for each in rows), 250.0)
+        prices = [each.reservation_price for each in rows]
+        self.assertEqual(prices, sorted(prices, reverse=True))
+
+    def test_stock_within_a_years_sales_is_one_offer(self):
+        self.assertEqual(len(self.rows(50.0)), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
