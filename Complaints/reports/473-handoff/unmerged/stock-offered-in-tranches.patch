+def stock_tranches(reservation: float, stock: float, expected_yearly_sales: float, interest_rate: float,
+                   spoilage_per_year: float, limit: int = STOCK_TRANCHES) -> List[Tuple[float, float]]:
+    """Held `stock` as (quantity, reservation) lots in queue order: each lot is a year of expected sales, worth held what its
+    last unit fetches (`queued_holding_value`), so the units that would sell next year ask the full reservation and those
+    that would wait years ask less. The last of `limit` lots takes the rest of the stock. Stock within a year of sales, a
+    reservation of nothing or less, or no expected sales is one lot at the reservation."""
+    if stock <= 0.0:
+        return []
+    surviving = 1.0 - min(1.0, max(0.0, spoilage_per_year))
+    if expected_yearly_sales <= 0.0 or reservation <= 0.0 or surviving <= 0.0 or limit < 2 or stock <= expected_yearly_sales:
+        return [(stock, reservation)]
+    carried = surviving / (1.0 + max(interest_rate, -0.99))
+    lots = []
+    taken = 0.0
+    while len(lots) < limit - 1 and stock - taken > expected_yearly_sales:
+        lots.append((expected_yearly_sales, reservation * carried ** float(len(lots))))
+        taken += expected_yearly_sales
+    lots.append((stock - taken, queued_holding_value(reservation, stock, expected_yearly_sales, interest_rate, spoilage_per_year)))
+    return lots
+
