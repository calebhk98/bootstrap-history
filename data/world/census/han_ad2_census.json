{
 "_doc": {
  "purpose": "The Western Han census of 2 AD as the Hanshu geography treatise records it: households and persons for each commandery and kingdom, placed at the seat of its government. Sizes the population the Han economy starts with on each tile.",
  "source": "Hanshu (Book of Han), juan 28, Dili zhi (Treatise on Geography), the census figures of AD 2 (Yuanshi 2); text at zh.wikisource.org/wiki/漢書/卷028上. Tabulated in Bielenstein, 'The Census of China during the Period 2-742 A.D.', Bulletin of the Museum of Far Eastern Antiquities 19 (1947).",
  "check": "The persons sum to 57,671,402 against the treatise's own total of 57,671,401.",
  "seat_lat_lon": "Approximate position of each commandery's seat of government, to a few tenths of a degree: used only to choose the nearest held map tile, so a commandery sits on the right part of the map, not on a surveyed point.",
  "fields": "name, chinese, households, persons, seat_lat, seat_lon"
 },
